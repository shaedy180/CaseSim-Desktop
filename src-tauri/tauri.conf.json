{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaseSim",
  "version": "22.7.53",
  "identifier": "de.shaedy.casesim.desktop",
  "mainBinaryName": "CaseSim",
  "build": {
    "frontendDist": "../desktop",
    "beforeBuildCommand": "npm run desktop:licenses",
    "beforeDevCommand": {
      "script": "npm run desktop:licenses",
      "wait": true
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "recovery",
        "desktop"
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "shaedy.de",
    "shortDescription": "CaseSim Desktop Preview",
    "longDescription": "The CaseSim online experience in a native Windows application. Requires an internet connection.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "target/notices/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "CaseSim"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
